---
const phone = "+7 (8652) 55-44-33";
const email = "hello@alyonka-teatr-stavropol.ru";
const address = "ул. Ленина, 45, Ставрополь, 355000";
---
<section id="contact" class="py-16 md:py-24 bg-white">
  <div class="container max-w-7xl grid lg:grid-cols-2 gap-12">
    <div>
      <h2 class="text-3xl md:text-4xl font-extrabold mb-6">Свяжитесь с нами</h2>
      <p class="text-gray-700 mb-6">Заполните форму, и мы перезвоним в течение рабочего дня. Или звоните прямо сейчас.</p>
      <ul class="space-y-2 text-gray-800 mb-8">
        <li><strong>Телефон:</strong> <a class="text-primary hover:text-secondary" href="tel:+78652554433">{phone}</a></li>
        <li><strong>Email:</strong> <a class="text-primary hover:text-secondary" href="mailto:{email}">{email}</a></li>
        <li><strong>Адрес:</strong> {address}</li>
      </ul>
      <a class="inline-block bg-secondary text-white px-5 py-3 rounded-md font-semibold hover:opacity-90" href="https://yandex.ru/maps/?text=ул.%20Ленина%2C%2045%2C%20Ставрополь" target="_blank" rel="noopener">Открыть на карте</a>
    </div>
    <div>
      <form action={`mailto:${email}`} method="post" encType="text/plain" class="bg-gray-50 p-6 rounded-lg border border-gray-200" aria-label="Форма обратной связи">
        <div class="grid gap-4">
          <div>
            <label for="name" class="block mb-1 font-medium">Ваше имя</label>
            <input id="name" name="name" type="text" required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label for="email" class="block mb-1 font-medium">Email</label>
            <input id="email" name="email" type="email" required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label for="phone" class="block mb-1 font-medium">Телефон</label>
            <input id="phone" name="phone" type="tel" class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary" />
          </div>
          <div>
            <label for="message" class="block mb-1 font-medium">Сообщение</label>
            <textarea id="message" name="message" rows={5} required class="w-full border border-gray-300 rounded-md px-3 py-2 focus:outline-none focus:ring-2 focus:ring-primary"></textarea>
          </div>
          <div>
            <button type="submit" class="bg-primary text-white px-6 py-3 rounded-md font-semibold hover:opacity-90">Отправить</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</section>
