---
const usp = "Очень дружелюбные и опытные актёры";
const about_paragraph_1 = "Мы — частный детский театр «алёнка» из Ставрополя. Уже более 7 лет создаём добрые спектакли и праздничные программы для детей от 3 до 12 лет. Наша миссия — развивать воображение и дарить детям уверенность через игру и театр.";
const about_paragraph_2 = "Команда профессиональных актёров и режиссёров разрабатывает сценарии под возраст и формат вашего события: день рождения, выпускной в садике, школьный праздник, семейный фестиваль или городское мероприятие.";
---
<section class="py-16 md:py-24">
  <div class="container max-w-5xl">
    <h2 class="text-3xl md:text-4xl font-extrabold mb-6">О нас</h2>
    <p class="text-lg text-gray-700 mb-4">{about_paragraph_1}</p>
    <p class="text-lg text-gray-700 mb-6">{about_paragraph_2}</p>
    <div class="p-6 rounded-lg bg-gradient-to-r from-secondary/10 to-accent/10 border border-gray-200">
      <p class="font-semibold">Наше преимущество: {usp}. Мы создаём безопасную, уважительную атмосферу и вовлекаем каждого ребёнка — даже самых застенчивых.</p>
    </div>
  </div>
</section>
